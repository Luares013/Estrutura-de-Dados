#include <stdio.h>

struct Funcionario {
    char nome[50];
    float salario_base;
    int tempo_empresa;
};

float salario_com_bonus(float salario_base, int tempo_empresa);

int main() {
    struct Funcionario f1;
    float salario_final;
    float bonus_percentual;

    printf("--- Cálculo de Salário com Bônus (Versão Simples) ---\n");
    
    printf("Digite o nome do funcionário: ");
    scanf("%s", f1.nome);

    printf("Digite o salário base (R$): ");
    scanf("%f", &f1.salario_base);
    
    printf("Digite o tempo de empresa (anos): ");
    scanf("%d", &f1.tempo_empresa);
    

    bonus_percentual = 0.10; 
    
    if (f1.tempo_empresa <= 3) {
        bonus_percentual = 0.05;
    }
    

    salario_final = f1.salario_base * (1.0 + bonus_percentual);

 
    printf("\n--- Detalhes do Funcionário ---\n");
    printf("Nome: %s\n", f1.nome);
    printf("Salário Base: R$ %.2f\n", f1.salario_base);
    printf("Tempo de Empresa: %d anos\n", f1.tempo_empresa);
    printf("Salário Final com Bônus: R$ **%.2f**\n", salario_final);

    return 0;
}
